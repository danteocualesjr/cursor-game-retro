{
  "name": "cursor-game-retro",
  "private": true,
  "version": "0.1.0",
  "description": "A retro pixel-art coding game for kids, with an AI tutor powered by the Cursor SDK.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspaces run build --if-present",
    "test": "npm --workspaces run test --if-present",
    "start": "npm --workspace backend run start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
