# Cursor SDK key, used by the backend to call the in-game AI tutor.
# Get one at https://cursor.com/dashboard/cloud-agents (user key)
# or Team Settings -> Service accounts (team key).
CURSOR_API_KEY=cursor_replace_me

# Backend HTTP port (frontend dev server proxies /api to this).
PORT=8787

# Optional: model id passed to Agent.prompt(). composer-2 is the default.
CURSOR_MODEL=composer-2
